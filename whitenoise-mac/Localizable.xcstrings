    "Search terms are sent to Openverse. Selected images are copied to Blossom before use.": {
      "comment": "A description of how the search and selected images are used.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchbegriffe werden an Openverse gesendet. Ausgewählte Bilder werden vor der Verwendung zu Blossom kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los términos de búsqueda se envían a Openverse. Las imágenes seleccionadas se copian a Blossom antes de usarse."
          }
        },
        "fr": {
          "stringUnit": {
