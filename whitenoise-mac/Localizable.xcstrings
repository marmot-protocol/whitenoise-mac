    "Blocking hides this person’s messages and prevents sending to them in direct chats. Existing history is retained." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockieren blendet die Nachrichten dieser Person aus und verhindert das Senden in direkten Chats. Der bisherige Verlauf bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocking hides this person’s messages and prevents sending to them in direct chats. Existing history is retained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al bloquear, se ocultan los mensajes de esta persona y no puedes enviarle mensajes directos. Se conserva el historial existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage masque les messages de cette personne et empêche de lui envoyer des messages directs. L’historique est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco nasconde i messaggi di questa persona e impedisce di inviarle messaggi diretti. La cronologia esistente viene conservata."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquear oculta as mensagens desta pessoa e impede o envio de mensagens diretas a ela. O histórico existente é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блокировка скрывает сообщения этого человека и запрещает отправлять ему личные сообщения. История сохраняется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engelleme bu kişinin iletilerini gizler ve ona doğrudan ileti göndermenizi önler. Mevcut geçmiş korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏蔽会隐藏此人的消息，并阻止你向其发送私聊消息。现有历史记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封鎖會隱藏此人的訊息，並阻止你向其傳送私聊訊息。現有歷史紀錄會保留。"
          }
        }
      }
    },
