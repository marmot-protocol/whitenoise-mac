    "Remove this identity from this Mac. Messages and keys managed by Marmot for this account will no longer be available locally.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne diese Identität von diesem Mac. Von Marmot für diesen Account verwaltete Nachrichten und Schlüssel sind lokal nicht mehr verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta identidad de este dispositivo. Los mensajes y llaves que Marmot gestiona para esta cuenta ya no estarán disponibles localmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez cette identité de ce Mac. Les messages et les clés gérés par Marmot pour ce compte ne seront plus disponibles localement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi questa identità da questo Mac. I messaggi e le chiavi gestiti da Marmot per questo account non saranno più disponibili in locale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova esta identidade deste Mac. As mensagens e chaves gerenciadas pelo Marmot para esta conta não estarão mais disponíveis localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите эту личность с этого Mac. Сообщения и ключи, управляемые Marmot для этого аккаунта, больше не будут доступны локально."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kimliği bu Mac’ten kaldırın. Marmot’un bu hesap için yönettiği mesajlar ve anahtarlar artık yerel olarak kullanılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此 Mac 移除该身份。Marmot 为此账户管理的消息和密钥将不再在本地可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此 Mac 移除該身分。Marmot 為此帳號管理的訊息和金鑰將不再於本機可用。"
          }
        }
      }
    },
