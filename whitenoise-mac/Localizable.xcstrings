    "White Noise encrypts cached attachment data on this Mac. Clearing it does not remove accounts, messages, drafts, or settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise verschlüsselt zwischengespeicherte Anhangsdaten auf diesem Mac. Das Leeren entfernt keine Accounts, Nachrichten, Entwürfe oder Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise cifra los datos de adjuntos en caché en este dispositivo. Borrarlos no elimina cuentas, mensajes, borradores ni ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise chiffre les données des pièces jointes en cache sur ce Mac. Les effacer ne supprime pas les comptes, messages, brouillons ni réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise crittografa i dati degli allegati nella cache su questo Mac. Svuotarla non rimuove account, messaggi, bozze o impostazioni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O White Noise criptografa os dados de anexos em cache neste Mac. Limpá-los não remove contas, mensagens, rascunhos ou configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise шифрует кэшированные данные вложений на этом Mac. Их очистка не удаляет аккаунты, сообщения, черновики и настройки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise, bu Mac’teki önbelleğe alınmış ek verilerini şifreler. Temizlemek hesapları, mesajları, taslakları veya ayarları kaldırmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 会加密此 Mac 上缓存的附件数据。清除缓存不会移除账户、消息、草稿或设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 會加密此 Mac 上快取的附件資料。清除快取不會移除帳號、訊息、草稿或設定。"
          }
        }
      }
    },
    "White Noise needs approval in Login Items before it can open at login." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise benötigt eine Freigabe in den Anmeldeobjekten, um beim Anmelden zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise necesita autorización en los ítems de inicio para abrirse al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise doit être autorisé dans les ouvertures de session pour démarrer automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise richiede l’approvazione negli elementi di login per aprirsi all’accesso."
          }
        },
        "pt" : {
          "stringUnit" : {
