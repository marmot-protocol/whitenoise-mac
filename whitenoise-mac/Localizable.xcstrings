    "Read from this Mac's delivery records. Upload Now on Privacy & Security resumes a paused account." : {
      "comment" : "Footer under the Developer mode audit delivery section.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
