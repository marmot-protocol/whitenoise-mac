    "Your relays refused this update because it's too large. Nothing was changed." : {
      "comment" : "Error when an account-level publish (profile, follow list, relay list, block list, key package, stickers) is too large for every relay.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
