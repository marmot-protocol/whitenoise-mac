    "Search these relays for your existing settings. This won’t publish changes to your profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuche diese Relays nach deinen bestehenden Einstellungen. Dabei werden keine Änderungen an deinem Profil veröffentlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca tu configuración existente en estos relays. No se publicarán cambios en tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez vos paramètres existants sur ces relais. Aucune modification de votre profil ne sera publiée."
