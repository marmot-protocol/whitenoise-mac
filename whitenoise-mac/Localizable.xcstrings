          "stringUnit": {
            "state": "translated",
            "value": "I gruppi archiviati sono nascosti dall’elenco delle chat attive."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupos arquivados ficam ocultos na lista de conversas ativas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные группы скрыты из списка активных чатов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen gruplar etkin sohbet listesinde gizlenir."
          }
        },
