          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise’un oturum açıldığında açılabilmesi için oturum açma öğelerinde onay gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White Noise 需要在“登录项”中获得批准，才能在登录时打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
