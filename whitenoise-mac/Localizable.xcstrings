    "You rejoined this chat. Messages from before you rejoined may be missing." : {
      "comment" : "History notice: this device rejoined the chat with a new copy, so messages from before the rejoin that it had not received are unavailable.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist diesem Chat erneut beigetreten. Nachrichten von vor deinem erneuten Beitritt fehlen möglicherweise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
