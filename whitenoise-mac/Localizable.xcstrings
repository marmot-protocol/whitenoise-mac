    "Name, photo, and bio are visible on the global Nostr network. Use what you're comfortable sharing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, Foto und Bio sind im globalen Nostr-Netzwerk sichtbar. Verwende Angaben, mit denen du dich wohlfühlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre, la foto y la biografía son visibles en la red global de Nostr. Usa lo que te resulte cómodo compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom, la photo et la bio sont visibles sur le réseau mondial de Nostr. Utilisez ce que vous êtes à l'aise de partager."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome, foto e bio sono visibili sulla rete globale di Nostr. Usa ciò che ti senti a tuo agio nel condividere."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome, foto e bio são visíveis na rede global do Nostr. Use o que você se sentir confortável em compartilhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, фото и биография видны в глобальной сети Nostr. Используйте то, чем вам комфортно делиться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsim, fotoğraf ve biyografi küresel Nostr ağında görünür. Paylaşırken kendinizi rahat hissedeceğiniz bilgileri kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称、照片和简介在全局 Nostr 网络中是公开可见的。请仅分享您愿意公开的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱、照片和簡介會在全球 Nostr 網路上公開顯示。請只分享您願意公開的內容。"
          }
        }
      }
    },
