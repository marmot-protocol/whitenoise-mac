    "Make another member an admin before removing the last admin.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache ein anderes Mitglied zum Admin, bevor du den letzten Admin entfernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra administrador a otro miembro antes de eliminar al último administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites d’un autre membre un administrateur avant de supprimer le dernier administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi un altro membro un amministratore prima di rimuovere l'ultimo amministratore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torne outro membro um administrador antes de remover o último administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте другого участника администратором, прежде чем удалять последнего администратора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yöneticiyi kaldırmadan önce başka bir üyeyi yönetici yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在删除最后一个管理员之前，先让另一个成员成为管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在刪除最後一個管理員之前，先讓另一個成員成為管理員。"
          }
        }
      }
    },
    "Make another member an admin before stepping down or leaving.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache ein anderes Mitglied zum Admin, bevor du zurücktrittst oder die Gruppe verlässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra administrador a otro miembro antes de renunciar o salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez un autre membre administrateur avant de vous retirer ou de partir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomina un altro membro amministratore prima di dimetterti o uscire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torne outro membro administrador antes de renunciar ou sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте другого участника администратором, прежде чем отказаться от прав или выйти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yöneticilikten ayrılmadan veya gruptan çıkmadan önce başka bir üyeyi yönetici yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在卸任或退出前，请先将另一位成员设为管理员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在卸任或離開前，請先將另一位成員設為管理員。"
          }
        }
      }
    },
