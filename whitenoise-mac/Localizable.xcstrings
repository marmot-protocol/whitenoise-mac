    "You'll stop receiving new messages in these chats. Their history will stay on this device until you delete it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst in diesen Chats keine neuen Nachrichten mehr. Der Verlauf bleibt auf diesem Gerät, bis du ihn löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll stop receiving new messages in these chats. Their history will stay on this device until you delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejarás de recibir mensajes nuevos en estos chats. Su historial permanecerá en este dispositivo hasta que lo elimines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevrez plus de nouveaux messages dans ces discussions. Leur historique restera sur cet appareil jusqu’à sa suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riceverai più nuovi messaggi in queste chat. La cronologia resterà su questo dispositivo finché non la elimini."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixará de receber novas mensagens nestas conversas. O histórico permanecerá neste dispositivo até o eliminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы перестанете получать новые сообщения в этих чатах. Их история останется на этом устройстве, пока вы её не удалите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sohbetlerde yeni mesaj almayı durduracaksınız. Sohbet geçmişi siz silene kadar bu cihazda kalacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将不再收到这些聊天中的新消息。聊天记录会保留在此设备上，直到你将其删除。"
