        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é o único administrador. Torne outro membro um administrador antes de sair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы единственный администратор. Прежде чем выйти, назначьте администратором другого участника."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek yöneticisin. Ayrılmadan önce başka bir üyeyi yönetici yap."
