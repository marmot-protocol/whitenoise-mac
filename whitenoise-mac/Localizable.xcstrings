    },
    "Archiving hides the chat from your main list. It doesn't notify anyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Archivieren wird der Chat aus deiner Hauptliste ausgeblendet. Niemand wird benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivar oculta el chat de tu lista principal. No se notifica a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archivage masque la discussion de votre liste principale. Personne n'est notifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archiviazione nasconde la chat dall'elenco principale. Nessuno riceve notifiche."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivar oculta a conversa da sua lista principal. Ninguém é notificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Архивация скрывает чат из основного списка. Никто не получит уведомление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivleme, sohbeti ana listenden gizler. Kimseye bildirim gitmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "归档会将聊天从主列表中隐藏，不会通知任何人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封存會將聊天從主清單中隱藏，不會通知任何人。"
          }
        }
      }
    },
    "Archiving hides the group from your main chats list. It doesn't change your membership or notify anyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Archivieren wird die Gruppe aus deiner Hauptchatliste ausgeblendet. An deiner Mitgliedschaft ändert sich nichts und es wird niemand benachrichtigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivar oculta el grupo de tu lista principal de chats. No cambia tu participación ni avisa a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archivage masque le groupe de votre liste de discussions principale. Cela ne modifie pas votre adhésion et n’en informe personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'archiviazione nasconde il gruppo dall'elenco delle chat principali. Non modifica la tua iscrizione né avvisa nessuno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivamento oculta o grupo da sua lista principal de bate-papos. Isso não altera sua associação nem notifica ninguém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При архивировании группа скрывается из основного списка чатов. Это не меняет ваше членство и не уведомляет кого-либо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivleme, grubu ana sohbet listenizden gizler. Üyeliğinizi değiştirmez veya kimseye bildirimde bulunmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
