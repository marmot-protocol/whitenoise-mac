    "Your report and the sender’s public key are sent privately to the White Noise team. The message itself isn’t shared, and the sender isn’t notified." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Meldung und der öffentliche Schlüssel des Absenders werden vertraulich an das White-Noise-Team gesendet. Die Nachricht selbst wird nicht geteilt, und der Absender wird nicht benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your report and the sender’s public key are sent privately to the White Noise team. The message itself isn’t shared, and the sender isn’t notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reporte y la llave pública del remitente se envían de forma privada al equipo de White Noise. El mensaje no se comparte y no se notifica al remitente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement et la clé publique de l’expéditeur sont envoyés en privé à l’équipe White Noise. Le message lui-même n’est pas partagé et l’expéditeur n’est pas averti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua segnalazione e la chiave pubblica del mittente vengono inviate in privato al team di White Noise. Il messaggio non viene condiviso e il mittente non riceve alcuna notifica."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua denúncia e a chave pública do remetente são enviadas de forma privada à equipe do White Noise. A mensagem em si não é compartilhada, e o remetente não é notificado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша жалоба и открытый ключ отправителя конфиденциально передаются команде White Noise. Само сообщение не передаётся, а отправитель не получает уведомления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildiriminiz ve gönderenin açık anahtarı White Noise ekibine gizli olarak gönderilir. İletinin kendisi paylaşılmaz ve gönderene bildirim yapılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的举报和发送者的公钥会私密地发送给 White Noise 团队。消息本身不会被分享，发送者也不会收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的檢舉和傳送者的公鑰會私密地傳送給 White Noise 團隊。訊息本身不會被分享，傳送者也不會收到通知。"
          }
        }
      }
    },
