    "Generates a fresh Nostr identity and stores the secret key securely in your device's Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzeugt eine neue Nostr-Identität und speichert den geheimen Schlüssel sicher im Schlüsselbund deines Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera una identidad Nostr nueva y guarda la llave secreta de forma segura en el llavero de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère une nouvelle identité Nostr et stocke la clé secrète en toute sécurité dans le trousseau de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera una nuova identità Nostr e memorizza la chiave segreta in modo sicuro nel portachiavi del tuo dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera uma nova identidade Nostr e armazena a chave secreta com segurança nas chaves do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает новый идентификатор Nostr и надежно сохраняет секретный ключ в связке ключей вашего устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir Nostr kimliği oluşturur ve gizli anahtarı cihazınızın Anahtarlığında güvenli bir şekilde saklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成新的 Nostr 身份并将密钥安全地存储在设备的钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生新的 Nostr 身分並將金鑰安全地儲存在裝置的鑰匙圈中。"
          }
        }
      }
    },
