    "An attachment shared in more than one chat counts in each." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Anhang, der in mehreren Chats geteilt wurde, zählt in jedem davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo adjunto compartido en más de un chat cuenta en cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pièce jointe partagée dans plusieurs discussions compte dans chacune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un allegato condiviso in più chat viene conteggiato in ciascuna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um anexo compartilhado em mais de um bate-papo é contado em cada um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложение, отправленное в несколько чатов, учитывается в каждом из них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla sohbette paylaşılan bir ek, her birinde sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多个聊天中共享的附件会在每个聊天中分别计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多個聊天中分享的附件會在每個聊天中分別計算。"
          }
        }
      }
    },
    "Anyone can see your name, photo, and bio, including people using other apps on the same network. You can use a nickname instead of your real name." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle können deinen Namen, dein Foto und deine Profilbeschreibung sehen, auch Personen, die andere Apps im selben Netzwerk nutzen. Du kannst einen Spitznamen statt deines echten Namens verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera puede ver tu nombre, foto y biografía, incluidas las personas que usan otras apps en la misma red. Puedes usar un apodo en lugar de tu nombre real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde peut voir votre nom, votre photo et votre biographie, y compris les personnes utilisant d’autres apps sur le même réseau. Vous pouvez utiliser un pseudonyme à la place de votre vrai nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque può vedere il tuo nome, la tua foto e la tua biografia, anche chi usa altre app sulla stessa rete. Puoi usare un soprannome invece del tuo vero nome."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa pode ver seu nome, foto e biografia, inclusive quem usa outros apps na mesma rede. Você pode usar um apelido em vez do seu nome real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше имя, фото и описание профиля видны всем, в том числе пользователям других приложений в той же сети. Вместо настоящего имени можно использовать псевдоним."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adınızı, fotoğrafınızı ve biyografinizi aynı ağdaki diğer uygulamaları kullananlar dahil herkes görebilir. Gerçek adınız yerine bir takma ad kullanabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都能看到你的名字、照片和个人简介，包括在同一网络上使用其他应用的人。你可以使用昵称，而不是真实姓名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都能看到你的名字、照片和個人簡介，包括在同一網路上使用其他 App 的人。你可以使用暱稱，而不是真實姓名。"
          }
        }
      }
    },
