    "This removes %@ of encrypted cached attachments. Visible media will download again when needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden %@ verschlüsselter zwischengespeicherter Anhänge entfernt. Sichtbare Medien werden bei Bedarf erneut geladen."
