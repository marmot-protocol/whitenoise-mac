    "System follows your Mac appearance. Light and Dark keep the selected appearance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System folgt dem Erscheinungsbild deines Macs. Hell und Dunkel behalten das gewählte Erscheinungsbild bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue la apariencia de tu Mac. Claro y Oscuro mantienen la apariencia seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit l’apparence de votre Mac. Clair et Sombre conservent l’apparence sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue l’aspetto del tuo Mac. Chiaro e Scuro mantengono l’aspetto selezionato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue a aparência do seu Mac. Claro e Escuro mantêm a aparência selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный следует оформлению Mac. Светлая и Тёмная сохраняют выбранное оформление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, Mac’inizin görünümünü izler. Açık ve Koyu seçilen görünümü korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统会跟随 Mac 的外观。浅色和深色会保持所选外观。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統會跟隨 Mac 的外觀。淺色和深色會保持所選外觀。"
          }
        }
      }
    },
    "System follows your Mac language. Other choices update White Noise immediately.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System folgt der Sprache deines Mac. Andere Optionen aktualisieren White Noise sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma de tu Mac. Las demás opciones actualizan White Noise de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit la langue de votre Mac. Les autres choix mettent White Noise à jour immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue la lingua del Mac. Le altre scelte aggiornano subito White Noise."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue o idioma do Mac. Outras escolhas atualizam o White Noise imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система следует языку Mac. Другие варианты сразу обновляют White Noise."
          }
        },
        "tr": {
          "stringUnit": {
