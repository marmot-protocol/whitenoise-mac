    "Turn audit logging on or off, and clear these files, in Privacy & Security." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audit-Protokollierung ein- oder ausschalten und diese Dateien löschen kannst du unter „Datenschutz & Sicherheit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva el registro de auditoría, y borra estos archivos, en Privacidad y seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez ou désactivez la journalisation d’audit, et effacez ces fichiers, dans Confidentialité et sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva la registrazione di audit, ed elimina questi file, in Privacy e sicurezza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative ou desative o registro de auditoria, e apague esses arquivos, em Privacidade e segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить или выключить журналирование аудита и очистить эти файлы можно в разделе «Конфиденциальность и безопасность»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim kaydını açıp kapatmayı ve bu dosyaları temizlemeyi Gizlilik ve güvenlik bölümünden yapabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“隐私与安全”中开启或关闭审计日志记录，并清除这些文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「隱私權與安全性」中開啟或關閉稽核日誌記錄，並清除這些檔案。"
          }
        }
      }
    },
