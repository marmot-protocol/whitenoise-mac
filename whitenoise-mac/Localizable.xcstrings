        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот человек пока не в White Noise. Поделитесь приложением, чтобы общаться защищённо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi henüz White Noise'da değil. Güvenli sohbet edebilmek için uygulamayı paylaşın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
