    "This account and all of its local data will be permanently removed from this Mac. Previous chats won't return." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Account und alle seine lokalen Daten werden dauerhaft von diesem Mac entfernt. Frühere Chats kommen nicht zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta y todos sus datos locales se eliminarán de forma permanente de este dispositivo. Los chats anteriores no volverán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte et toutes ses données locales seront définitivement supprimés de ce Mac. Les conversations précédentes ne reviendront pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account e tutti i suoi dati locali verranno rimossi definitivamente da questo Mac. Le chat precedenti non torneranno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta e todos os seus dados locais serão removidos permanentemente deste Mac. Os chats anteriores não voltarão."
          }
        },
        "ru" : {
          "stringUnit" : {
