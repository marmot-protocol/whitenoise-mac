    "Share only what you’re comfortable making public. Photos may stay online even after you remove them from your profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile nur das, was du öffentlich machen möchtest. Fotos können auch dann online bleiben, wenn du sie aus deinem Profil entfernst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte solo lo que quieras hacer público. Las fotos pueden seguir en internet aunque las elimines de tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez uniquement ce que vous souhaitez rendre public. Les photos peuvent rester en ligne même après leur suppression de votre profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi solo ciò che vuoi rendere pubblico. Le foto potrebbero restare online anche dopo averle rimosse dal profilo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe apenas o que você se sente à vontade para tornar público. As fotos podem permanecer online mesmo depois de removidas do perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делитесь только тем, что готовы сделать общедоступным. Фотографии могут остаться в интернете даже после удаления из профиля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca herkese açık olmasını istediğiniz bilgileri paylaşın. Fotoğraflar, profilinizden kaldırsanız bile internette kalabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只分享你愿意公开的内容。即使你从个人资料中移除照片，它们仍可能留在网上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只分享你願意公開的內容。即使你從個人資料中移除照片，它們仍可能留在網路上。"
          }
        }
      }
    },
