    },
    "You were made an admin of this group. To decline, you'll first step down as admin, which the group's members can see." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wurdest zum Admin dieser Gruppe gemacht. Um abzulehnen, trittst du zuerst als Admin zurück. Das sehen die Mitglieder der Gruppe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te hicieron administrador de este grupo. Para rechazar, primero dejarás de ser administrador, y los miembros del grupo podrán verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez été nommé admin de ce groupe. Pour refuser, vous renoncerez d’abord à ce rôle, ce que les membres du groupe pourront voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato nominato amministratore di questo gruppo. Per rifiutare, rinuncerai prima al ruolo di amministratore, e i membri del gruppo potranno vederlo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você foi definido como administrador deste grupo. Para recusar, primeiro você deixará de ser administrador, e os membros do grupo poderão ver isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вас назначили администратором этой группы. Чтобы отклонить приглашение, сначала вы откажетесь от роли администратора — участники группы это увидят."
          }
        },
        "tr" : {
          "stringUnit" : {
