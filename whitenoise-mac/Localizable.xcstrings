    "Notifications show who sent the message and its contents." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen zeigen, wer die Nachricht gesendet hat, und deren Inhalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones muestran quién envió el mensaje y su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications indiquent qui a envoyé le message et son contenu."
          }
        },
