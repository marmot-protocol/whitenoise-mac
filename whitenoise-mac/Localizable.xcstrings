    "This relay uses cleartext ws://, so the metadata this account sends it is not encrypted in transit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Relay verwendet Klartext-ws://, daher werden die Metadaten, die dieser Account an es sendet, bei der Übertragung nicht verschlüsselt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este relé usa ws:// en texto plano, así que los metadatos que esta cuenta le envía no se cifran en tránsito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce relais utilise ws:// en clair, donc les métadonnées que ce compte lui envoie ne sont pas chiffrées en transit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo relay usa ws:// in chiaro, quindi i metadati che questo account gli invia non sono cifrati durante il transito."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este relay usa ws:// em texto simples, então os metadados que esta conta envia a ele não são criptografados em trânsito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот релей использует незашифрованный ws://, поэтому метаданные, которые этот аккаунт ему отправляет, не шифруются при передаче."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu relay şifresiz ws:// kullanıyor, bu yüzden bu hesabın ona gönderdiği meta veriler aktarım sırasında şifrelenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此中继使用明文 ws://，因此此账户发送给它的元数据在传输过程中不会被加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此中繼使用明文 ws://，因此此帳號傳送給它的元資料在傳輸過程中不會加密。"
          }
        }
      }
    },
    "This removes %@ from the group." : {
      "extractionState" : "manual",
      "localizations" : {
