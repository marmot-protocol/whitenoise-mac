    "Older attachments are moving out of the chat database in the background. Nothing is deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Anhänge werden im Hintergrund aus der Chat-Datenbank verschoben. Es wird nichts gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos adjuntos antiguos se están moviendo fuera de la base de datos de chats en segundo plano. No se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces jointes plus anciennes sont déplacées hors de la base de données des discussions en arrière-plan. Rien n’est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli allegati meno recenti vengono spostati fuori dal database delle chat in background. Non viene eliminato nulla."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os anexos mais antigos estão sendo movidos para fora do banco de dados dos bate-papos em segundo plano. Nada é excluído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старые вложения переносятся из базы данных чатов в фоновом режиме. Ничего не удаляется."
