    "Notifications only say a new message arrived.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen melden nur, dass eine neue Nachricht eingegangen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones solo indican que llegó un nuevo mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications indiquent seulement qu'un nouveau message est arrivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche indicano solo che è arrivato un nuovo messaggio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações apenas informam que chegou uma nova mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления сообщают только о том, что пришло новое сообщение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler yalnızca yeni bir mesaj geldiğini belirtir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知仅提示有新消息到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知僅提示有新訊息送達。"
          }
        }
      }
    },
    "Notifications show who sent the message and its contents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen zeigen, wer die Nachricht gesendet hat, und deren Inhalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones muestran quién envió el mensaje y su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications indiquent qui a envoyé le message et son contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche mostrano chi ha inviato il messaggio e il suo contenuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações mostram quem enviou a mensagem e o seu conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления показывают, кто отправил сообщение, и его содержимое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler, mesajı kimin gönderdiğini ve içeriğini gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知会显示谁发送了消息及其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知會顯示誰傳送了訊息及其內容。"
          }
        }
      }
    },
    "Notifications show who sent the message but not its contents.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen zeigen, wer die Nachricht gesendet hat, aber nicht deren Inhalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones muestran quién envió el mensaje, pero no su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications indiquent qui a envoyé le message, mais pas son contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche mostrano chi ha inviato il messaggio, ma non il suo contenuto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações mostram quem enviou a mensagem, mas não o seu conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления показывают, кто отправил сообщение, но не его содержимое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler, mesajı kimin gönderdiğini gösterir ancak içeriğini göstermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
