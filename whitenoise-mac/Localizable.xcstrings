          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu derleme için telemetri kimlik bilgileri yapılandırılmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建未配置遥测凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
