    "Keep this key safe and don't share it with anyone. Anyone with it can use your profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre diesen Schlüssel sicher auf und teile ihn mit niemandem. Jeder, der ihn besitzt, kann dein Profil verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda esta llave en un lugar seguro y no la compartas con nadie. Cualquiera que la tenga puede usar tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez cette clé en lieu sûr et ne la partagez avec personne. Toute personne qui la possède peut utiliser votre profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva questa chiave al sicuro e non condividerla con nessuno. Chiunque la possieda può usare il tuo profilo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde esta chave em segurança e não a partilhe com ninguém. Qualquer pessoa que a tenha pode usar o seu perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните этот ключ в безопасности и никому его не передавайте. Любой, у кого он есть, может пользоваться вашим профилем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu anahtarı güvende tutun ve kimseyle paylaşmayın. Anahtara sahip olan herkes profilinizi kullanabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请妥善保管此密钥，不要与任何人分享。任何持有它的人都能使用你的个人资料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請妥善保管此金鑰，不要與任何人分享。任何持有它的人都能使用你的個人檔案。"
          }
        }
      }
    },
    "Keep your private key somewhere safe. If you lose it, White Noise can't recover it. We recommend protecting your backup with a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre deinen privaten Schlüssel an einem sicheren Ort auf. Wenn du ihn verlierst, kann White Noise ihn nicht wiederherstellen. Wir empfehlen, dein Backup mit einem Passwort zu schützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu llave privada en un lugar seguro. Si la pierdes, White Noise no podrá recuperarla. Te recomendamos proteger la copia de seguridad con una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez votre clé privée en lieu sûr. Si vous la perdez, White Noise ne pourra pas la récupérer. Nous vous recommandons de protéger votre sauvegarde avec un mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la tua chiave privata in un luogo sicuro. Se la perdi, White Noise non può recuperarla. Ti consigliamo di proteggere il backup con una password."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde sua chave privada em um local seguro. Se você a perder, o White Noise não poderá recuperá-la. Recomendamos proteger seu backup com uma senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните приватный ключ в безопасном месте. Если вы его потеряете, White Noise не сможет его восстановить. Рекомендуем защитить резервную копию паролем."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel anahtarınızı güvenli bir yerde saklayın. Kaybederseniz White Noise anahtarınızı kurtaramaz. Yedeğinizi bir parolayla korumanızı öneririz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请妥善保管你的私钥。如果丢失，White Noise 无法帮你恢复。我们建议使用密码保护备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請妥善保管你的私鑰。如果遺失，White Noise 無法幫你復原。我們建議使用密碼保護備份。"
          }
        }
      }
    },
