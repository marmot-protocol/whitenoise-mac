    "Archived groups are hidden from the active chat list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Gruppen werden in der aktiven Chatliste ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos archivados se ocultan de la lista de chats activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes archivés sont masqués dans la liste des discussions actives."
          }
        },
