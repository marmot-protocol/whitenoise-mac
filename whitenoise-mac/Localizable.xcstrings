    "Stickers load from servers each pack’s author chose. Those servers can see your IP address." : {
      "comment" : "Disclosure: loading stickers contacts third-party servers.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker werden von Servern geladen, die der Autor des jeweiligen Pakets gewählt hat. Diese Server können deine IP-Adresse sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los stickers se cargan desde servidores elegidos por el autor de cada paquete. Esos servidores pueden ver tu dirección IP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autocollants sont chargés depuis des serveurs choisis par l’auteur de chaque pack. Ces serveurs peuvent voir votre adresse IP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli sticker vengono caricati da server scelti dall’autore di ogni pacchetto. Questi server possono vedere il tuo indirizzo IP."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As figurinhas são carregadas de servidores escolhidos pelo autor de cada pacote. Esses servidores podem ver seu endereço IP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стикеры загружаются с серверов, выбранных автором каждого набора. Эти серверы могут видеть ваш IP-адрес."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkartmalar, her paketin yazarının seçtiği sunuculardan yüklenir. Bu sunucular IP adresinizi görebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴纸从各贴纸包作者选择的服务器加载。这些服务器可以看到你的 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼圖從各貼圖包作者選擇的伺服器載入。這些伺服器可以看到你的 IP 位址。"
          }
        }
      }
    },
