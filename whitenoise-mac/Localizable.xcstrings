    "Creates message notifications on this Mac. Without native push, delivery may wait until White Noise is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt Nachrichtenbenachrichtigungen auf diesem Mac. Ohne Native Push kann die Zustellung warten, bis White Noise läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea las notificaciones de mensajes en este Mac. Sin push nativo, la entrega puede esperar a que White Noise esté en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée les notifications de messages sur ce Mac. Sans push natif, la remise peut attendre que White Noise soit en cours d'exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea le notifiche dei messaggi su questo Mac. Senza push nativo, la consegna può attendere che White Noise sia in esecuzione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria as notificações de mensagens neste Mac. Sem push nativo, a entrega pode esperar até o White Noise estar em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт уведомления о сообщениях на этом Mac. Без нативных push-уведомлений доставка может ждать, пока White Noise не будет запущен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te mesaj bildirimleri oluşturur. Yerel push olmadan teslimat, White Noise çalışana kadar bekleyebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上创建消息通知。若未启用原生推送，通知可能要等到 White Noise 运行时才会送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上建立訊息通知。若未啟用原生推播，通知可能要等到 White Noise 執行時才會送達。"
          }
        }
      }
    },
