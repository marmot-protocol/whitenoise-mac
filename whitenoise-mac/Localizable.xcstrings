    },
    "This removes %@ of encrypted cached attachments. Visible media will download again when needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden %@ verschlüsselter zwischengespeicherter Anhänge entfernt. Sichtbare Medien werden bei Bedarf erneut geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina %@ de adjuntos cifrados en caché. Los medios visibles se descargarán de nuevo cuando sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime %@ de pièces jointes chiffrées en cache. Les médias visibles seront téléchargés à nouveau si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuove %@ di allegati crittografati nella cache. I media visibili verranno scaricati di nuovo quando necessario."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove %@ de anexos criptografados em cache. As mídias visíveis serão baixadas novamente quando necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит %@ зашифрованных кэшированных вложений. Видимые медиафайлы будут загружены снова при необходимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %@ şifreli önbellek ekini kaldırır. Görünen medya gerektiğinde yeniden indirilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将移除 %@ 的加密缓存附件。可见媒体会在需要时重新下载。"
