// App target build settings shared by Debug and Release.
// Put local secrets in Config/AppSecrets.xcconfig. That file is ignored.

// Build flavor. These are production's values; Config/Staging.xcconfig includes this file and
// overrides them for the side-by-side staging app (Debug-Staging / Release-Staging). The bundle
// id and product name stay in project.pbxproj for production. See AppFlavor.swift.
WN_FLAVOR = production
WN_DISPLAY_NAME = White Noise
WN_URL_SCHEME = marmot
// The Icon Composer files live in one synchronized folder; each flavor compiles only its own.
EXCLUDED_SOURCE_FILE_NAMES = AppIcon-Staging.icon

OTLP_TOKEN_WN_MAC =
AUDIT_LOG_TOKEN_WN_MAC =
WN_PRODUCT_ANALYTICS_ENDPOINT =
WN_PRODUCT_ANALYTICS_APP_KEY =
WN_PRODUCT_ANALYTICS_OPERATOR = white_noise
WN_PRODUCT_ANALYTICS_RETENTION =

// GIF search. Without a key the composer hides its GIF button; received GIFs still render.
GIPHY_API_KEY_WN_MAC =
WN_GIPHY_API_KEY = $(GIPHY_API_KEY_WN_MAC)

// IPF's moderation-reports key (an npub, public by design). "Report" and "Block and Report"
// gift-wrap a private copy to it. Debug uses the staging key so test reports never reach the
// production queue. Leave it empty to hide the report-to-White-Noise options.
WN_MODERATION_REPORT_PUBKEY_Debug = npub1vnlg8lzm48f3awy0lqqhff66rzaxxyqf85twvyrnj6ycjtfy47rsk52fml
WN_MODERATION_REPORT_PUBKEY_Release = npub1cwlgauttl8fr3va4gy0sawq62sjt8hrz4wc200pvkrz6fjdj7tlseeq8rl
WN_MODERATION_REPORT_PUBKEY = $(WN_MODERATION_REPORT_PUBKEY_$(CONFIGURATION))

#include? "AppSecrets.xcconfig"
