# Local build secrets
Config/AppSecrets.xcconfig

# MarmotKit resolves from a pinned remote binary target, so nothing binary is
# vendored. The generated Swift, MARMOT_VERSION and Package.swift are tracked —
# that is what lets a fresh clone build with no mdk checkout. This rule only
# guards against an XCFramework left behind by an older local build.
Vendored/MarmotKit/MarmotKit.xcframework/

# Misc
*.log
*.swp
.idea/
reviews/

trees/
